# Finales de línea fijos: el repo es LF y así se queda también en un checkout de Windows
# (runners windows-latest con core.autocrlf=true), para que los .sh y los fixtures no cambien.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binarios: sin conversión ni diff de texto
*.zip binary
*.wav binary
*.flac binary
*.mp3 binary
*.f32 binary
*.i32 binary
*.png binary
*.woff2 binary
*.sf2 binary
*.mlpackage binary
*.mlmodel binary
*.onnx binary
