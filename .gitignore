.DS_Store

# Informes y logs de Tools/test.sh, capturas de tf-qa
Temp/

# Swift / Xcode
.build/
.swiftpm/
DerivedData/
xcuserdata/
*.xcuserstate

# Python de desarrollo (conversión de modelos)
Tools/py/.venv/
__pycache__/

# Salidas de las pruebas de la Fase 0: pesos, modelos convertidos, audios de comparación
Probes/*/out/
Probes/*/*/out/

# Claude Code local
.claude/settings.local.json
.claude/worktrees/

# Helpers embebidos (yt-dlp, Deno, ffmpeg): se regeneran con Tools/helpers/*.sh
Vendor/helpers/

# ONNX Runtime y DirectML para Windows (NuGet): se bajan con Tools/win/fetch-ort.sh
Vendor/win/

# Modelo lead/rhythm (149 MB, por encima del límite de 100 MB de GitHub): adjunto de la release
# models-v1; se baja con Tools/models/fetch.sh
App/Resources/Models/LeadRhythmMelRoformer_fp16.mlpackage.zip

# Local secrets (Spotify Web API keys): el real vive en Application Support, nunca aquí
.env
.env.*
!.env.example
