# Spotify Web API keys (client credentials flow), used only to search songs from
# "Importar tema" in the library. Metadata and audio do not need them (ADR-008).
#
# Real file: ~/Library/Application Support/ToneForge/.env (chmod 600), never in the repo.
# The app reads <support dir>/.env, falls back to the default support dir above, and
# environment variables with the same names override both (tests, CLI runs).
#
# Keys: https://developer.spotify.com/dashboard -> ToneForge -> Settings.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
