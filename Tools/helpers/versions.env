# Versiones y SHA-256 fijados de los helpers embebidos (spec, «Helpers embebidos»).
# yt-dlp y Deno: sumas de SHA2-256SUMS / .sha256sum de cada release oficial.
# ffmpeg: suma calculada tras bajar el tarball de ffmpeg.org (que solo publica firma PGP .asc).
YTDLP_VERSION=2026.10.26
YTDLP_SHA256=0f922c15ccc0b83eefa1c8bc9104e434318c4bf16e408e1ee93b7745a6efe0aa
DENO_VERSION=2.9.8
DENO_SHA256=9f0bf660393da2eaff044cdc7444cb08c73f235849b61d224d825a194ce7c98e
FFMPEG_VERSION=9.0.2
FFMPEG_SHA256=8c3850283eb25fa026482078a04051e0be17347b09ef81a0849bec15a96e002e

# Windows (Fase 7c, paso 7.5). Mismos yt-dlp y Deno que en el Mac; sumas de SHA2-256SUMS de yt-dlp y del
# .sha256sum de Deno (comprobadas el 19/11/2026 contra el digest que publica GitHub).
# yt-dlp tiene build ARM64 estable (yt-dlp_arm64.exe) desde esta version: no hace falta el x64 emulado.
YTDLP_WIN_X64_SHA256=f5389d3698ecde4ef06f4e6b1ce0294fe9ac1396228c8990b8d3416d6d177a7d
YTDLP_WIN_ARM64_SHA256=0066dbac3c124028e2dcae2a197fccee33cd91f456313d24f7af89fd54590e98
# Deno oficial para Windows ARM64 existe desde 2.7.0 (yt-dlp exige >= 2.3.0).
DENO_WIN_X64_SHA256=cba84b26e0df5ae7f74fc66b86a95b866872a86292ebd84fa1e959927edd93bf
DENO_WIN_ARM64_SHA256=b413b92b735b50c198e8fe3b85af1aa50e29d5f72e229aab701d132286e14cef
# ffmpeg: BtbN FFmpeg-Builds, variante LGPL (estatica, sin GPL), autobuild mensual (no se borra) con FFmpeg n9.0.2.
# Como proceso aparte basta aviso de licencia y enlace a la fuente (LICENSE.txt va junto al exe).
FFMPEG_WIN_TAG=autobuild-2026-10-31-12-59
FFMPEG_WIN_BUILD=n9.0.2-39-g7adfbe40dc
FFMPEG_WIN_X64_SHA256=9d37c564e0d01c18cde184a079fa6ef04d7d2783ada41da81d04165cc8f1a650
FFMPEG_WIN_ARM64_SHA256=d1981518b99a1c05d6b864200b1ac9459b09e2ee174feffe84b6e6bb0bfa79e2
